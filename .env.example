# מסד נתונים PostgreSQL
DATABASE_URL="postgresql://app:app@localhost:5432/procurement"
# מפתח לחתימת עוגיית ההתחברות, 32 תווים לפחות. בייצור: ערך אקראי וסודי
SESSION_SECRET="change-me-to-a-long-random-string-32+"
# מפתח API של Claude לחיפוש מוצר בצילום (אופציונלי). בלי מפתח המסך מציג שהחיפוש לא הופעל
ANTHROPIC_API_KEY=""

# אימייל (Resend, https://resend.com). בלי אלה ההתראות מופיעות רק בתוך המערכת
RESEND_API_KEY=""
# השולח, מדומיין שאומת ב-Resend. למשל: "השוואת ספקים <alerts@example.co.il>"
EMAIL_FROM=""
# כתובת האתר, לקישורים באימייל
APP_URL="http://localhost:3000"
# מפתח למשימות התקופתיות (/api/cron/notifications), אם מפעילים אותן משירות חיצוני
CRON_SECRET=""
